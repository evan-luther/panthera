+#ifdef PANTHERA
+static void
+panthera_sshd_trace(const char *message)
+{
+	size_t len = 0;
+#if defined(__x86_64__)
+	long ret;
+#endif
+	int fd;
+
+	if (message == NULL)
+		return;
+	while (message[len] != '\0')
+		len++;
+#if defined(__x86_64__)
+	__asm__ volatile("syscall" : "=a"(ret)
+	    : "a"(0x2000004), "D"(STDERR_FILENO), "S"(message), "d"(len)
+	    : "rcx", "r11", "memory");
+	__asm__ volatile("syscall" : "=a"(ret)
+	    : "a"(0x2000004), "D"(STDERR_FILENO), "S"("\n"), "d"(1)
+	    : "rcx", "r11", "memory");
+#else
+	(void)write(STDERR_FILENO, message, len);
+	(void)write(STDERR_FILENO, "\n", 1);
+#endif
+	fd = open("/dev/console", O_WRONLY | O_NOCTTY | O_NONBLOCK);
+	if (fd >= 0) {
+		(void)write(fd, message, len);
+		(void)write(fd, "\n", 1);
+		(void)close(fd);
+	}
+}
+
+static void
+panthera_sshd_tracef(const char *fmt, ...)
+{
+	char buf[256];
+	va_list ap;
+
+	va_start(ap, fmt);
+	(void)vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	buf[sizeof(buf) - 1] = '\0';
+	panthera_sshd_trace(buf);
+}
