--- entropy.c.orig
+++ entropy.c
@@ -51,6 +51,30 @@
 #include "sshbuf.h"
 #include "ssherr.h"
 
+static void
+panthera_seed_trace(const char *message)
+{
+	size_t len = 0;
+#if defined(__x86_64__)
+	long ret;
+#endif
+	if (message == NULL)
+		return;
+	while (message[len] != '\0')
+		len++;
+#if defined(__x86_64__)
+	__asm__ volatile("syscall" : "=a"(ret)
+	    : "a"(0x2000004), "D"(STDERR_FILENO), "S"(message), "d"(len)
+	    : "rcx", "r11", "memory");
+	__asm__ volatile("syscall" : "=a"(ret)
+	    : "a"(0x2000004), "D"(STDERR_FILENO), "S"("\n"), "d"(1)
+	    : "rcx", "r11", "memory");
+#else
+	(void)write(STDERR_FILENO, message, len);
+	(void)write(STDERR_FILENO, "\n", 1);
+#endif
+}
+
