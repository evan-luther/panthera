+#ifdef PANTHERA
+static void
+panthera_session_child_trace(const char *label)
+{
+	char buf[192];
+	int fd, n;
+
+	n = snprintf(buf, sizeof(buf),
+	    "PANTHERA:sshd child pid=%ld %s\n", (long)getpid(), label);
+	if (n < 0)
+		return;
+	if ((size_t)n > sizeof(buf))
+		n = sizeof(buf);
+	fd = open("/dev/console", O_WRONLY | O_NONBLOCK);
+	if (fd >= 0) {
+		(void)write(fd, buf, (size_t)n);
+		(void)close(fd);
+	}
+}
+#else
+#define panthera_session_child_trace(label) do { } while (0)
+#endif
+
