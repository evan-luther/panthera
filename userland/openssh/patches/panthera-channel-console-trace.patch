+static void
+panthera_channel_tracef(const char *fmt, ...)
+{
+	char buf[256];
+	va_list ap;
+	int fd;
+
+	va_start(ap, fmt);
+	(void)vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	buf[sizeof(buf) - 1] = '\0';
+
+	fd = open("/dev/console", O_WRONLY | O_NONBLOCK);
+	if (fd >= 0) {
+		(void)write(fd, buf, strlen(buf));
+		(void)write(fd, "\n", 1);
+		(void)close(fd);
+	}
+}
+#else
+#define panthera_channel_tracef(...) do { } while (0)
+#endif
