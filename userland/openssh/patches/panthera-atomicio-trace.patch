 /*
  * ensure all of data on socket comes through. f==read || f==vwrite
  */
+#ifdef PANTHERA
+static void
+panthera_atomicio_tracef(const char *fmt, ...)
+{
+	char buf[256];
+	va_list ap;
+	int fd;
+
+	va_start(ap, fmt);
+	(void)vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	buf[sizeof(buf) - 1] = '\0';
+	(void)write(STDERR_FILENO, buf, strlen(buf));
+	(void)write(STDERR_FILENO, "\n", 1);
+	fd = open("/dev/console", O_WRONLY);
+	if (fd >= 0) {
+		(void)write(fd, buf, strlen(buf));
+		(void)write(fd, "\n", 1);
+		(void)close(fd);
+	}
+}
+#else
+#define panthera_atomicio_tracef(...) do { } while (0)
+#endif
