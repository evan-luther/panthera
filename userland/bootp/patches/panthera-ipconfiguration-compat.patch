+	    if (callout->timer != NULL && delta > 0) {
+		dispatch_source_set_timer(callout->timer,
+					  dispatch_time(DISPATCH_TIME_NOW, delta),
+					  DISPATCH_TIME_FOREVER,
+					  0);
