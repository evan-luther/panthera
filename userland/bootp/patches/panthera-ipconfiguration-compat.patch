+}
+
+static void
+panthera_bootp_trace(const char *message)
+{
+    if (!panthera_bootp_trace_enabled()) {
+	return;
+    }
+    (void)write(STDERR_FILENO, message, strlen(message));
+}
+
+static void
+panthera_bootp_tracef(const char *fmt, ...)
+{
+    char buffer[256];
+    va_list ap;
+    int len;
+
+    if (!panthera_bootp_trace_enabled()) {
+	return;
+    }
+    va_start(ap, fmt);
+    len = vsnprintf(buffer, sizeof(buffer), fmt, ap);
+    va_end(ap);
+    if (len <= 0) {
+	return;
+    }
+    if ((size_t)len >= sizeof(buffer)) {
+	len = (int)sizeof(buffer) - 1;
+    }
+    (void)write(STDERR_FILENO, buffer, (size_t)len);
+}
+
+static ssize_t
+panthera_recvmsg(int fd, struct msghdr *msg, int flags)
+{
+    ssize_t n = recvmsg(fd, msg, flags);
+
+    /*
+     * Panthera's current BSD syscall return path can expose a 32-bit -1 as a
+     * zero-extended value while leaving errno set. Treat that ABI shape as the
+     * Darwin recvmsg failure it represents so nonblocking socket drains can
+     * terminate at EAGAIN instead of parsing an absent packet.
+     */
+    if ((uint64_t)n == UINT32_MAX && errno != 0) {
+	return (-1);
+    }
+    return (n);
+}
