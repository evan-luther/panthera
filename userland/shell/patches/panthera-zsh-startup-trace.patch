+
+static void
+panthera_stage_write(const char *msg, int add_newline)
+{
+    int fd;
+
+    if (!msg)
+	return;
+    fd = open("/dev/console", O_WRONLY | O_NONBLOCK);
+    if (fd < 0)
+	return;
+    (void)write(fd, msg, strlen(msg));
+    if (add_newline)
+	(void)write(fd, "\n", 1);
+    (void)close(fd);
+}
+
+static void
+panthera_stage(const char *msg)
+{
+    panthera_stage_write(msg, 1);
+}
+
+static void
+panthera_stage_num(const char *prefix, int value, const char *suffix)
+{
+    char buf[32];
+    char *p = buf + sizeof(buf);
+    unsigned int v;
+    int neg = value < 0;
+
+    panthera_stage_write(prefix, 0);
+    *--p = '\0';
+    v = neg ? (unsigned int)(-value) : (unsigned int)value;
+    do {
+        *--p = (char)('0' + (v % 10));
+        v /= 10;
+    } while (v);
+    if (neg)
+        *--p = '-';
+    panthera_stage_write(p, 0);
+    panthera_stage_write(suffix ? suffix : "", 1);
+}
+#else
+#define panthera_stage(msg) ((void)0)
+#define panthera_stage_num(prefix, value, suffix) ((void)0)
+#endif
