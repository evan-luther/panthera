#!/usr/bin/expect -f
# Test read-write root filesystem mount
set timeout 120

spawn env PANTHERA_NOGRAPHIC=1 /Users/admin/panthera/boot/qemu/run_phase2_qemu.sh \
    --no-reboot --ssh-port 0 \
    --root-disk /Users/admin/panthera/images/qemu/panthera-root.img

# Wait for shell prompt
expect {
    -re {(%|#)\s*$} { send_user "\n>>> GOT PROMPT <<<\n" }
    timeout { send_user "\n>>> TIMEOUT waiting for prompt <<<\n"; exit 1 }
}
sleep 2

# T1: Check if root was remounted rw (launchd message in boot log)
send_user "\n=== T1: Check rw remount ===\n"
send "mount | grep ' / '\r"
expect {
    -re {read-only} { send_user ">>> T1 FAIL: still read-only <<<\n" }
    -re {read-write|rw} { send_user ">>> T1 PASS: root is read-write <<<\n" }
    timeout { send_user ">>> T1 TIMEOUT <<<\n" }
}
expect -re {(%|#)\s*$}

# T2: touch a file
send_user "\n=== T2: touch file ===\n"
send "touch /tmp/test_rw && echo TOUCH_OK || echo TOUCH_FAIL\r"
expect {
    -re {TOUCH_OK} { send_user ">>> T2 PASS: touch succeeded <<<\n" }
    -re {TOUCH_FAIL|read-only} { send_user ">>> T2 FAIL <<<\n" }
    timeout { send_user ">>> T2 TIMEOUT <<<\n" }
}
expect -re {(%|#)\s*$}

# T3: File redirection
send_user "\n=== T3: File redirection ===\n"
send "echo hello > /tmp/redir_test && cat /tmp/redir_test\r"
expect {
    -re {hello} { send_user ">>> T3 PASS: redirection works <<<\n" }
    -re {read-only} { send_user ">>> T3 FAIL: read-only <<<\n" }
    timeout { send_user ">>> T3 TIMEOUT <<<\n" }
}
expect -re {(%|#)\s*$}

# T4: rm test
send_user "\n=== T4: rm file ===\n"
send "rm /tmp/redir_test && echo RM_OK || echo RM_FAIL\r"
expect {
    -re {RM_OK} { send_user ">>> T4 PASS: rm succeeded <<<\n" }
    -re {RM_FAIL} { send_user ">>> T4 FAIL <<<\n" }
    timeout { send_user ">>> T4 TIMEOUT <<<\n" }
}
expect -re {(%|#)\s*$}

# T5: mkdir
send_user "\n=== T5: mkdir ===\n"
send "mkdir /tmp/test_dir && echo MKDIR_OK || echo MKDIR_FAIL\r"
expect {
    -re {MKDIR_OK} { send_user ">>> T5 PASS: mkdir succeeded <<<\n" }
    -re {MKDIR_FAIL} { send_user ">>> T5 FAIL <<<\n" }
    timeout { send_user ">>> T5 TIMEOUT <<<\n" }
}
expect -re {(%|#)\s*$}

send_user "\n=== ALL DONE ===\n"
sleep 1
send "\x01"
sleep 0.5
send "x"
sleep 2
exit 0
