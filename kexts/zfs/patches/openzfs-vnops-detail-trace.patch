+#ifdef PANTHERA_ZFS_VNOPS_DETAIL_TRACE
+typedef struct panthera_zfs_detail_setattr_phase {
+	volatile uint64_t count;
+	volatile uint64_t errors;
+	volatile uint64_t total_ns;
+	volatile uint64_t mode_lookup_ns;
+	volatile uint64_t flags_ns;
+	volatile uint64_t core_ns;
+	volatile uint64_t support_ns;
+	volatile uint64_t mode_count;
+	volatile uint64_t time_count;
+	volatile uint64_t size_count;
+	volatile uint64_t uidgid_count;
+} panthera_zfs_detail_setattr_phase_t;
+
+typedef struct panthera_zfs_detail_rmdir_phase {
+	volatile uint64_t count;
+	volatile uint64_t errors;
+	volatile uint64_t total_ns;
+	volatile uint64_t core_ns;
+	volatile uint64_t purge_ns;
+} panthera_zfs_detail_rmdir_phase_t;
+
+static panthera_zfs_detail_setattr_phase_t panthera_zfs_detail_setattr_phase;
+static panthera_zfs_detail_rmdir_phase_t panthera_zfs_detail_rmdir_phase;
+
+static uint64_t
+panthera_zfs_detail_delta(hrtime_t start, hrtime_t end)
+{
+	return (end > start ? (uint64_t)(end - start) : 0);
+}
+
+static void
+panthera_zfs_detail_add(volatile uint64_t *counter, uint64_t value)
+{
+	atomic_add_64(counter, value);
+}
+
+static uint64_t
+panthera_zfs_detail_inc(volatile uint64_t *counter)
+{
+	return (atomic_add_64_nv(counter, 1));
+}
+
+static uint64_t
+panthera_zfs_detail_ms(uint64_t ns)
+{
+	return (ns / 1000000ULL);
+}
+
+static void
+panthera_zfs_detail_setattr_record(int error, uint64_t mask,
+    uint64_t total_ns, uint64_t mode_lookup_ns, uint64_t flags_ns,
+    uint64_t core_ns, uint64_t support_ns)
+{
+	uint64_t count;
 
+	count = panthera_zfs_detail_inc(&panthera_zfs_detail_setattr_phase.count);
+	if (error != 0)
+		panthera_zfs_detail_inc(
+		    &panthera_zfs_detail_setattr_phase.errors);
+	if (mask & ATTR_MODE)
+		panthera_zfs_detail_inc(
+		    &panthera_zfs_detail_setattr_phase.mode_count);
+	if (mask & (ATTR_ATIME | ATTR_MTIME))
+		panthera_zfs_detail_inc(
+		    &panthera_zfs_detail_setattr_phase.time_count);
+	if (mask & ATTR_SIZE)
+		panthera_zfs_detail_inc(
+		    &panthera_zfs_detail_setattr_phase.size_count);
+	if (mask & (ATTR_UID | ATTR_GID))
+		panthera_zfs_detail_inc(
+		    &panthera_zfs_detail_setattr_phase.uidgid_count);
+	panthera_zfs_detail_add(&panthera_zfs_detail_setattr_phase.total_ns,
+	    total_ns);
+	panthera_zfs_detail_add(
+	    &panthera_zfs_detail_setattr_phase.mode_lookup_ns,
+	    mode_lookup_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_setattr_phase.flags_ns,
+	    flags_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_setattr_phase.core_ns,
+	    core_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_setattr_phase.support_ns,
+	    support_ns);
+
+	if ((count & 0xfff) == 0) {
+		printf("PANTHERA:ZFS_DETAIL setattr count=%llu errors=%llu "
+		    "mode_ops=%llu time_ops=%llu size_ops=%llu uidgid_ops=%llu "
+		    "total_ms=%llu mode_lookup_ms=%llu flags_ms=%llu "
+		    "core_ms=%llu support_ms=%llu\n",
+		    (u_longlong_t)count,
+		    (u_longlong_t)panthera_zfs_detail_setattr_phase.errors,
+		    (u_longlong_t)panthera_zfs_detail_setattr_phase.mode_count,
+		    (u_longlong_t)panthera_zfs_detail_setattr_phase.time_count,
+		    (u_longlong_t)panthera_zfs_detail_setattr_phase.size_count,
+		    (u_longlong_t)panthera_zfs_detail_setattr_phase.uidgid_count,
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_setattr_phase.total_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_setattr_phase.mode_lookup_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_setattr_phase.flags_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_setattr_phase.core_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_setattr_phase.support_ns));
+	}
+}
+
+static void
+panthera_zfs_detail_rmdir_record(int error, uint64_t total_ns,
+    uint64_t core_ns, uint64_t purge_ns)
+{
+	uint64_t count;
+
+	count = panthera_zfs_detail_inc(&panthera_zfs_detail_rmdir_phase.count);
+	if (error != 0)
+		panthera_zfs_detail_inc(&panthera_zfs_detail_rmdir_phase.errors);
+	panthera_zfs_detail_add(&panthera_zfs_detail_rmdir_phase.total_ns,
+	    total_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_rmdir_phase.core_ns,
+	    core_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_rmdir_phase.purge_ns,
+	    purge_ns);
+
+	if ((count & 0x3ff) == 0) {
+		printf("PANTHERA:ZFS_DETAIL rmdir count=%llu errors=%llu "
+		    "total_ms=%llu core_ms=%llu purge_ms=%llu\n",
+		    (u_longlong_t)count,
+		    (u_longlong_t)panthera_zfs_detail_rmdir_phase.errors,
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_rmdir_phase.total_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_rmdir_phase.core_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_rmdir_phase.purge_ns));
+	}
+}
+#endif
