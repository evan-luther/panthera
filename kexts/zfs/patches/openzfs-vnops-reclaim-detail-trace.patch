+static void
+panthera_zfs_detail_reclaim_record(boolean_t sa_null, boolean_t unlinked,
+    uint64_t total_ns, uint64_t setup_ns, uint64_t clear_ns,
+    uint64_t rwlock_ns, uint64_t zinactive_ns, uint64_t znode_free_ns)
+{
+	uint64_t count;
+
+	count = panthera_zfs_detail_inc(
+	    &panthera_zfs_detail_reclaim_phase.count);
+	if (sa_null)
+		panthera_zfs_detail_inc(
+		    &panthera_zfs_detail_reclaim_phase.sa_null_count);
+	if (unlinked)
+		panthera_zfs_detail_inc(
+		    &panthera_zfs_detail_reclaim_phase.unlinked_count);
+	panthera_zfs_detail_add(&panthera_zfs_detail_reclaim_phase.total_ns,
+	    total_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_reclaim_phase.setup_ns,
+	    setup_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_reclaim_phase.clear_ns,
+	    clear_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_reclaim_phase.rwlock_ns,
+	    rwlock_ns);
+	panthera_zfs_detail_add(&panthera_zfs_detail_reclaim_phase.zinactive_ns,
+	    zinactive_ns);
+	panthera_zfs_detail_add(
+	    &panthera_zfs_detail_reclaim_phase.znode_free_ns, znode_free_ns);
+
+	if ((count & 0x3ff) == 0) {
+		printf("PANTHERA:ZFS_DETAIL reclaim count=%llu "
+		    "sa_null=%llu unlinked=%llu total_ms=%llu setup_ms=%llu "
+		    "clear_ms=%llu rwlock_ms=%llu zinactive_ms=%llu "
+		    "znode_free_ms=%llu\n",
+		    (u_longlong_t)count,
+		    (u_longlong_t)panthera_zfs_detail_reclaim_phase.sa_null_count,
+		    (u_longlong_t)panthera_zfs_detail_reclaim_phase.unlinked_count,
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_reclaim_phase.total_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_reclaim_phase.setup_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_reclaim_phase.clear_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_reclaim_phase.rwlock_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_reclaim_phase.zinactive_ns),
+		    (u_longlong_t)panthera_zfs_detail_ms(
+		    panthera_zfs_detail_reclaim_phase.znode_free_ns));
+	}
+}
 #endif
 
