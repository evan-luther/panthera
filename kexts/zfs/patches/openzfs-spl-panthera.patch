+{
+	pool_list_t *pools = zfs_boot_pool_list;
+
+	if (!pools || pools->terminating != ZFS_BOOT_ACTIVE)
+		return;
+
+	zfs_boot_seed_existing_media(pools->zfs_hl, pools);
