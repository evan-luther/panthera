+static int
+zfs_xnu_uiomove_chunked(const char *p, size_t n, enum uio_rw rw,
+    struct uio *uio)
+{
+	while (n > 0) {
+		size_t chunk = MIN(n, PAGE_SIZE);
+		int error;
+
+		error = uiomove(p, chunk, uio);
+		if (error != 0)
+			return (error);
+		p += chunk;
+		n -= chunk;
+	}
+	return (0);
+}
