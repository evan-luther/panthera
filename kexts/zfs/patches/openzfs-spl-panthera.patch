+DSTATIC void
+zfs_boot_seed_existing_media(IOService *zfs_hl, pool_list_t *pools)
+{
+	OSDictionary *matching = NULL;
+	OSIterator *iter = NULL;
+	OSObject *obj = NULL;
+	IOService *service = NULL;
+
+	if (!zfs_hl || !pools)
+		return;
+
+	matching = IOService::serviceMatching("IOMedia");
+	if (!matching) {
+		printf("%s: no IOMedia matching dictionary\n",
+		    __func__);
+		return;
+	}
 
+	iter = IOService::getMatchingServices(matching);
+	matching->release();
+	matching = NULL;
+	if (!iter) {
+		printf("%s: no existing IOMedia iterator\n",
+		    __func__);
+		return;
+	}
+
+	while ((obj = iter->getNextObject()) != NULL) {
+		service = OSDynamicCast(IOService, obj);
+		if (!service)
+			continue;
+		(void) zfs_boot_probe_media(zfs_hl, pools, service, NULL);
+	}
+
+	iter->release();
+}
+
